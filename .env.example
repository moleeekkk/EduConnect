# ====================================================================
# EDUCONNECT SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure real credentials for production.
# NEVER commit real passwords or JWT secrets to Git repositories!
# ====================================================================

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/educonnect_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgresql_password

# SMTP Real Email Configuration (Gmail App Password supported)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_account@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM=your_gmail_account@gmail.com

# Spring Security & JWT Configuration
JWT_SECRET=YourSuperSecureJwtSigningSecretKeyMinimum32BytesLong2026!
JWT_EXPIRATION_MS=86400000

# Student Portal OTP System Properties
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Embedded Web Server Port
SERVER_PORT=8081
